# 复制成 .env 再改。.env 不进版本库。

# 实训用 DeepSeek 密钥，由老师单独发放。懂妈答疑与交卷后的 AI 测评报告都用它。
DEEPSEEK_API_KEY=

# 浏览器访问的端口，被占用时改掉，例如 8081。
WEB_PORT=8080
# 宿主机连数据库的端口，用于在本机用数据库客户端查看数据。
MYSQL_PORT=3307
# 宿主机直接调懂妈 /ask 接口的端口，评测脚本用。
DONGMA_PORT=28790

# 以下都只在本机使用，可以不改。
